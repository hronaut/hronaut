{
  "name": "hronaut",
  "version": "1.11.28",
  "description": "A visible local Browser MCP for coding agents with persistent tabs and isolated workspaces",
  "desktopName": "Hronaut",
  "author": "Hronaut",
  "homepage": "https://hronaut.dev",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hronaut/hronaut.git"
  },
  "bugs": {
    "url": "https://github.com/hronaut/hronaut/issues"
  },
  "keywords": [
    "ai-agents",
    "browser-automation",
    "browser-mcp",
    "coding-agents",
    "electron",
    "mcp",
    "model-context-protocol",
    "persistent-browser",
    "qa-automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "electron-vite build",
    "build:website": "vite build --config vite.website.config.ts",
    "capture:marketing": "node scripts/capture-marketing-assets.ts",
    "preview:website": "vite preview --config vite.website.config.ts",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build:app && electron-builder --linux --publish never",
    "package:mac": "npm run build:app && electron-builder --mac --publish never",
    "package:win": "npm run build:app && electron-builder --win --publish never",
    "publish:linux": "npm run build && electron-builder --linux --publish always",
    "publish:mac": "npm run build && electron-builder --mac --publish always",
    "publish:win": "npm run build && electron-builder --win --publish always",
    "typecheck": "npm run typecheck:incremental",
    "typecheck:incremental": "node scripts/run-typecheck-projects.ts",
    "typecheck:web": "vue-tsc --build --noEmit tsconfig.web.json",
    "typecheck:node": "tsc --build --noEmit tsconfig.node.json",
    "typecheck:website": "tsc --build --noEmit tsconfig.website.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/run-static-gates.ts",
    "validate:focused": "node scripts/run-focused-static-gates.ts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --cache-strategy content --max-warnings 0",
    "lint:focused": "eslint --cache --cache-location node_modules/.cache/eslint --cache-strategy content --max-warnings 0",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "test:integration": "npm run build && playwright test",
    "test:integration:run": "playwright test",
    "test:integration:headless": "npm run build && npm run test:integration:headless:run",
    "test:integration:headless:run": "xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' npm run test:integration:run",
    "test:integration:dialogs": "node scripts/dialog-integration.ts",
    "test:integration:dialogs:headless": "xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24' npm run test:integration:dialogs",
    "test:unit:docker:focused": "node scripts/run-focused-docker.ts unit",
    "test:integration:docker:focused": "node scripts/run-focused-docker.ts integration",
    "test:integration:docker:fast": "node scripts/run-focused-docker.ts integration-all",
    "test:docker:cache:prune": "node scripts/run-focused-docker.ts prune",
    "test:integration:docker": "docker compose --file compose.test.ci.yaml run --build --rm integration",
    "test:package:smoke": "node scripts/packaged-mcp-smoke.ts",
    "smoke:mcp": "node scripts/mcp-smoke.ts",
    "smoke:profile:prepare": "node scripts/profile-smoke.ts prepare",
    "smoke:profile:write": "node scripts/profile-smoke.ts write",
    "smoke:profile:read": "node scripts/profile-smoke.ts read",
    "smoke:profile:cleanup": "node scripts/profile-smoke.ts cleanup"
  },
  "dependencies": {
    "@foleyjs/core": "^2.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ciphers": "^2.4.0",
    "@node-rs/argon2": "2.1.0",
    "@scure/bip39": "^2.4.0",
    "@solana/kit": "^8.1.0",
    "@vueuse/core": "^14.4.0",
    "@wallet-standard/core": "^1.1.2",
    "@wallet-standard/features": "^1.1.1",
    "axe-core": "4.13.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "micro-key-producer": "^0.10.0",
    "pinia": "^4.0.3",
    "tronweb": "^6.5.0",
    "viem": "^2.56.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "web-vitals": "6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.90",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/vue": "^8.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "electron": "42.10.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  }
}
