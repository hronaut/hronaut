FROM mcr.microsoft.com/playwright:v1.63.0-noble AS install-inputs

WORKDIR /inputs
COPY package-lock.json ./
COPY scripts/docker-install-inputs.ts ./scripts/
RUN node scripts/docker-install-inputs.ts package-lock.json /install

FROM mcr.microsoft.com/playwright:v1.63.0-noble AS dependencies

ENV CI=true
WORKDIR /workspace

COPY --from=install-inputs /install/package.json /install/package-lock.json ./
COPY scripts/docker-dependency-cache-key.ts ./scripts/
RUN npm ci \
    && node node_modules/electron/install.js \
    && ./node_modules/.bin/electron-builder install-app-deps \
    && node scripts/docker-dependency-cache-key.ts package-lock.json > node_modules/.hronaut-package-lock.sha256

RUN apt-get update \
    && apt-get install --yes --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*

FROM dependencies AS integration

COPY . .

CMD ["bash", "scripts/run-integration-suite-docker.sh"]
