{
  "name": "hronaut",
  "displayName": "Hronaut",
  "version": "3.12.0",
  "description": "Connects your coding agent to Hronaut — a visible desktop browser it can drive over MCP. Watch every step, pause and take over, keep logins between sessions. Requires the Hronaut app (free 10-day trial at hronaut.dev).",
  "author": {
    "name": "Hronaut",
    "url": "https://hronaut.dev"
  },
  "homepage": "https://hronaut.dev",
  "repository": "https://github.com/hronaut/hronaut",
  "license": "SEE LICENSE IN LICENSE",
  "privacyPolicyUrl": "https://hronaut.dev/privacy",
  "termsOfServiceUrl": "https://hronaut.dev/terms",
  "documentationUrl": "https://hronaut.dev/claude-code-browser-mcp",
  "supportUrl": "https://github.com/hronaut/hronaut/issues",
  "icon": "./.claude-plugin/icon.png",
  "keywords": ["browser", "mcp", "qa", "testing", "automation", "localhost"],
  "userConfig": {
    "mcp_url": {
      "type": "string",
      "title": "Hronaut MCP address",
      "description": "Hronaut's local MCP endpoint. Change the port only if you changed Hronaut's MCP port.",
      "default": "http://127.0.0.1:47812/mcp"
    }
  },
  "mcpServers": {
    "hronaut": {
      "type": "http",
      "url": "${user_config.mcp_url}",
      "headers": {
        "Authorization": "Bearer ${HRONAUT_MCP_TOKEN:-}"
      },
      "headersHelper": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hronaut-headers.sh\" || \"${CLAUDE_PLUGIN_ROOT}/scripts/hronaut-headers.cmd\""
    }
  }
}
